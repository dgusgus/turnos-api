# Copia este archivo a .env y ajusta los valores.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# PostgreSQL (coincide con docker-compose.yml)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/turnos_api?schema=public

# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia-esto-por-un-secreto-largo-de-al-menos-32-caracteres
JWT_EXPIRES_IN=1h

# Orígenes permitidos del frontend, separados por coma
CORS_ORIGIN=http://localhost:5173

# Reglas de las citas (opcionales; estos son los valores por defecto)
CITA_MAX_ACTIVAS=2                # citas vigentes por CI o teléfono
CITA_MAX_DIAS_ANTICIPACION=30     # hasta cuántos días adelante se puede reservar
CITA_MIN_ANTICIPACION_MIN=60      # no se reserva una hora que empieza en menos de esto
CITA_PENDIENTE_EXPIRA_HORAS=24    # una cita pendiente sin respuesta se rechaza sola

# "true" si la API corre detrás de un proxy o hosting (necesario para el rate limit por IP)
TRUST_PROXY=false

# Solo para `pnpm db:seed` (en producción son obligatorios)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Admin12345!
